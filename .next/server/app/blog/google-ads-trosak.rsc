ase tracking-widest text-ink-muted flex items-center gap-2","aria-label":"Breadcrumb","children":[["$","$L3",null,{"href":"/","className":"hover:text-ink-text transition","children":"Početna"}],["$","span",null,{"children":"/"}],["$","$L3",null,{"href":"/blog","className":"hover:text-ink-text transition","children":"Blog"}],["$","span",null,{"children":"/"}],["$","span",null,{"className":"text-ink-text","children":"Google Ads Trošak"}]]}],["$","div",null,{"className":"text-center mb-12 md:mb-16","children":[["$","span",null,{"className":"bg-wine text-ink-text text-[10px] md:text-[11px] font-mono uppercase px-4 py-1.5 md:px-5 md:py-2 rounded-full tracking-widest","children":"Ekspertska Analiza"}],["$","h1",null,{"className":"font-display font-medium text-2xl md:text-4xl lg:text-5xl text-ink-text mt-6 mb-6 md:mb-8 leading-tight px-2","children":"Zašto vaši Google oglasi troše novac bez konverzija? 7 razloga"}],["$","p",null,{"className":"text-lg md:text-2xl text-ink-muted max-w-2xl mx-auto leading-relaxed","children":"Klikovi stižu, budžet nestaje, ali telefon ne zvoni? Evo surove istine o tome gde grešite, i kako to odmah popraviti."}],["$","div",null,{"className":"flex items-center justify-center gap-4 mt-6 font-mono text-[11px] text-ink-muted uppercase tracking-widest","children":[["$","span",null,{"children":"Duck Family Team"}],["$","span",null,{"children":"·"}],["$","time",null,{"dateTime":"2026-04-01","children":"1. april 2026."}],["$","span",null,{"children":"·"}],["$","span",null,{"children":"10 min čitanja"}]]}]]}],["$","$L4",null,{"src":"https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=1200","alt":"Google Ads analitika, troškovi bez konverzija","width":1200,"height":600,"className":"w-full h-[250px] md:h-[500px] object-cover rounded-2xl mb-12 md:mb-16 border border-ink-border","priority":true}],["$","div",null,{"className":"bg-ink-surface border border-ink-border rounded-2xl p-6 md:p-12 lg:p-16 space-y-10 md:space-y-12 text-ink-muted text-base md:text-xl","children":[["$","p",null,{"className":"leading-relaxed","children":["Mnogi vlasnici biznisa uđu u svet Google Ads-a sa uverenjem:"," ",["$","strong",null,{"className":"text-ink-text font-medium","children":"\"Ako platim klik, dobiću kupca.\""}]," Realnost je često brutalno drugačija. Google je mašina koja će vrlo rado potrošiti svaki vaš cent ako joj precizno ne kažete šta želite. U ovom tekstu ćemo proći kroz ",["$","strong",null,{"children":"7 najčešćih razloga"}]," zašto Google Ads kampanje u Srbiji troše budžet bez rezultata, i šta konkretno možete da uradite."]}],["$","div",null,{"className":"space-y-4 md:space-y-6","children":[["$","h2",null,{"className":"font-display font-medium text-2xl md:text-3xl lg:text-4xl text-ink-text leading-tight","children":"1. Ne gađate nameru, već samo reč"}],["$","p",null,{"className":"leading-relaxed","children":["Ovo je najčešća greška. Ako prodajete \"luksuzne satove\", a vaš oglas se pojavljuje za pretragu \"kako popraviti stari sat\", vi gubite novac. Platili ste klik osobi koja želi ",["$","strong",null,{"className":"text-ink-text font-medium","children":"besplatan savet"}],", a ne ",["$","strong",null,{"className":"text-ink-text font-medium","children":"novi proizvod"}],"."]}],["$","p",null,{"className":"leading-relaxed","children":"U srpskom kontekstu ovo je posebno izraženo. Mnoge firme targetuju generičke reči poput \"advokat\", \"zubar\" ili \"auto servis\", a da ne specificiraju lokaciju, tip usluge ili nameru kupca. Rezultat: platite klik studenta koji istražuje profesije, a ne klijenta koji traži vašu uslugu."}],["$","p",null,{"className":"leading-relaxed","children":["Postoje četiri tipa pretražnog namere: ",["$","strong",null,{"children":"informational"}]," (žele da uče), ",["$","strong",null,{"children":"navigational"}]," (traže specifičan sajt), ",["$","strong",null,{"children":"commercial investigation"}]," (porede opcije) i ",["$","strong",null,{"children":"transactional"}]," (spremni da kupe). Vi plaćate samo za poslednje dve."]}],["$","div",null,{"className":"bg-ink-bg p-5 md:p-8 border-l-4 border-wine rounded-r-xl shadow-sm","children":["$","p",null,{"className":"text-ink-text m-0","children":[["$","strong",null,{"className":"text-wine-bright uppercase text-xs md:text-sm tracking-widest block mb-2","children":"Rešenje"}],"Koristite negativne ključne reči i fokusirajte se na \"Buyer Intent\" termine: \"prodaja satova cena Beograd\", \"kupovina luksuznog sata\" umesto samo \"satovi\". Revidirajte Search Terms izveštaj svake nedelje i dodajte irelevantne pretrage u negativnu listu."]}]}]]}],["$","div",null,{"className":"space-y-4 md:space-y-6","children":[["$","h2",null,{"className":"font-display font-medium text-2xl md:text-3xl lg:text-4xl text-ink-text leading-tight","children":"2. Landing stranica je hladan tuš"}],["$","p",null,{"className":"leading-relaxed","children":["Zamislite da kliknete na oglas \"dubinsko pranje tepiha Beograd\", a sajt vas odvede na početnu stranicu gde se priča o istoriji firme i čišćenju prozora. ",["$","span",null,{"className":"text-wine-bright font-medium","children":"Kupac odlazi u roku od 3 sekunde."}]]}],["$","p",null,{"className":"leading-relaxed","children":["Oglas je obećanje, a vaša stranica mora biti ",["$","strong",null,{"className":"text-ink-text font-medium","children":"ispunjenje tog obećanja"}],". Mora postojati savršena koherentnost između naslova oglasa, ključnih reči i sadržaja stranice. Google to naziva \"message match\", i direktno utiče na vaš Quality Score."]}],["$","p",null,{"className":"leading-relaxed","children":"Osim relevantnosti, problemi su i tehničke prirode. Ako stranica ne učitava za ispod 3 sekunde na mobilnom telefonu, gubi se prosečno 53% posetilaca. U Srbiji, gde se više od 65% pretrage odvija na mobilnim uređajima, ovo je kritično."}],["$","div",null,{"className":"bg-ink-bg p-5 md:p-8 border-l-4 border-ink-border rounded-r-xl shadow-sm","children":["$","p",null,{"className":"text-ink-text m-0","children":[["$","strong",null,{"className":"text-ink-muted uppercase text-xs md:text-sm tracking-widest block mb-2","children":"Rešenje"}],"Svaki oglas treba da vodi na posebnu landing stranicu koja odgovara tačno na ono što je korisnik tražio. Proverite brzinu učitavanja u Google PageSpeed Insights, cilj je ispod 2.5s. Dodajte jasnu CTA (call-to-action) u prvih 100px stranice."]}]}]]}],["$","div",null,{"className":"space-y-4 md:space-y-6","children":[["$","h2",null,{"className":"font-display font-medium text-2xl md:text-3xl lg:text-4xl text-ink-text leading-tight","children":"3. Algoritam ne zna šta je za vas uspeh"}],["$","p",null,{"className":"leading-relaxed","children":["Ako niste ispravno podesili ",["$","strong",null,{"className":"text-ink-text font-medium","children":"Conversion Tracking"}]," u GA4, Google-ov AI luta u mraku. On optimizuje kampanju za klikove, a ne za prodaje. Rezultat? Mnogo saobraćaja, ali nula profita."]}],["$","p",null,{"className":"leading-relaxed","children":["Ovo je posebno osetljivo kada koristite ",["$","strong",null,{"children":"Smart Bidding"}]," strategije kao što su Target CPA ili Maximize Conversions. Bez tačnih konverzionih signala, algoritam uči na pogrešnim podacima i vremenom postaje sve gori, čak i dok troši sve više novca."]}],["$","div",null,{"className":"bg-ink-bg p-5 md:p-8 border-l-4 border-wine rounded-r-xl shadow-sm","children":["$","p",null,{"className":"text-ink-text m-0","children":[["$","strong",null,{"className":"text-wine-bright uppercase text-xs md:text-sm tracking-widest block mb-2","children":"Rešenje"}],"Podesite GA4 konverzije putem Google Tag Manager-a. Pratite svaki klik na telefon (tel: link), svaki popunjen formular, svaku kupovinu. Importujte GA4 konverzije u Google Ads. Sačekajte minimum 30 do 50 konverzija pre nego što aktivirate Target CPA bidding."]}]}]]}],["$","div",null,{"className":"space-y-4 md:space-y-6","children":[["$","h2",null,{"className":"font-display font-medium text-2xl md:text-3xl lg:text-4xl text-ink-text leading-tight","children":"4. Nemate negativne ključne reči"}],["$","p",null,{"className":"leading-relaxed","children":["Negativne ključne reči su možda ",["$","strong",null,{"children":"najjači alat za smanjenje troškova"}]," u Google Ads-u, i najzanemareniji. Bez robusne liste negativnih reči, vaši oglasi se prikazuju za irelevantne pretrage i vi plaćate za klikove koji nikada neće konvertovati."]}],["$","p",null,{"className":"leading-relaxed","children":"Tipičan primer za srpsko tržište: firma koja nudi plaćene računovodstvene usluge prikazuje oglas za pretragu \"besplatni računovodstveni program\". Ili agencija za nekretnine koja želi kupce prikazuje se za \"iznajmljivanje stanova\". To su realni troškovi bez ikakvog potencijala za konverziju."}],["$","div",null,{"className":"bg-ink-bg p-5 md:p-8 border-l-4 border-wine rounded-r-xl shadow-sm","children":["$","p",null,{"className":"text-ink-text m-0","children":[["$","strong",null,{"className":"text-wine-bright uppercase text-xs md:text-sm tracking-widest block mb-2","children":"Rešenje"}],"Izgradite negativnu listu pre pokretanja kampanje: dodajte \"besplatan\", \"kako\", \"sam\", \"DIY\", \"šta je\", \"Wikipedia\" i slično. Svake nedelje pregledajte Search Terms izveštaj i dodajte nove negativne reči."]}]}]]}],["$","div",null,{"className":"space-y-4 md:space-y-6","children":[["$","h2",null,{"className":"font-display font-medium text-2xl md:text-3xl lg:text-4xl text-ink-text leading-tight","children":"5. Loš Quality Score, plaćate više, dobijate manje"}],["$","p",null,{"className":"leading-relaxed","children":["Quality Score je ocena od 1 do 10 koju Google daje svakoj ključnoj reči u vašoj kampanji. Ona se zasniva na: ",["$","strong",null,{"children":"Expected CTR"}]," (koliko se očekuje da će korisnici kliknuti), ",["$","strong",null,{"children":"Ad relevance"}]," (koliko je oglas relevantan za ključnu reč) i ",["$","strong",null,{"children":"Landing page experience"}]," (kvalitet vaše stranice)."]}],["$","p",null,{"className":"leading-relaxed","children":["Zašto je ovo ključno? Jer Quality Score direktno utiče na cenu klika. Sa Quality Score 10, možete plaćati i do ",["$","strong",null,{"children":"50% manje"}]," po kliku nego konkurent sa Quality Score 5, čak i za iste pozicije. Loš Quality Score znači da plaćate penale za irelevantnost."]}],["$","div",null,{"className":"bg-ink-bg p-5 md:p-8 border-l-4 border-ink-border rounded-r-xl shadow-sm","children":["$","p",null,{"className":"text-ink-text m-0","children":[["$","strong",null,{"className":"text-ink-muted uppercase text-xs md:text-sm tracking-widest block mb-2","children":"Rešenje"}],"Grupišite ključne reči u uske ad grupe (1 do 3 bliske reči po grupi). Pišite naslove oglasa koji sadrže tačnu ključnu reč. Osigurajte da landing stranica ima sadržaj direktno vezan za ključnu reč. Ciljajte Quality Score 7 ili više za svaku reč."]}]}]]}],["$","div",null,{"className":"space-y-4 md:space-y-6","children":[["$","h2",null,{"className":"font-display font-medium text-2xl md:text-3xl lg:text-4xl text-ink-text leading-tight","children":"6. Pogrešno vreme i lokacija prikazivanja"}],["$","p",null,{"className":"leading-relaxed","children":"Da li znate u koje sate i koji dani vaša ciljna publika u Srbiji traži vaše usluge? Ako ne, verovatno trošite deo budžeta u trenutku kada niko ne kupuje, ili kada su konkurentski troškovi po kliku najviši, ali konverzije najniže."}],["$","p",null,{"className":"leading-relaxed","children":"Na primer, B2B usluge se retko kupuju vikendom. Restoran verovatno nema potrebe da prikazuje oglase u 3h ujutru. Lokalna firma u Beogradu ne treba da prikazuje oglase korisnicima u Novom Sadu ako ne šalje tamo. Sve ovo su troškovi koji se mogu eliminisati."}],["$","div",null,{"className":"bg-ink-bg p-5 md:p-8 border-l-4 border-wine rounded-r-xl shadow-sm","children":["$","p",null,{"className":"text-ink-text m-0","children":[["$","strong",null,{"className":"text-wine-bright uppercase text-xs md:text-sm tracking-widest block mb-2","children":"Rešenje"}],"Analizirajte GA4 i Google Ads izveštaje po danu i satu. Podesite bid adjustments (korekcije ponuda) za periode niže konverzije. Koristite location targeting na nivou grada ili radijusa. Isključite nerentabilne periode iz prikazivanja."]}]}]]}],["$","div",null,{"className":"space-y-4 md:space-y-6","children":[["$","h2",null,{"className":"font-display font-medium text-2xl md:text-3xl lg:text-4xl text-ink-text leading-tight","children":"7. Ignorišete mobilne vs desktop performanse"}],["$","p",null,{"className":"leading-relaxed","children":["U Srbiji, ",["$","strong",null,{"children":"više od 60% pretrage"}]," se odvija na mobilnim uređajima. Ali za mnoge industrije, konverzije i dalje dolaze pretežno sa desktopa jer korisnici istražuju na telefonu, a kupuju ili kontaktiraju sa računara. Ako tretirate sve uređaje jednako, plaćate previše za mobilne klikove koji retko konvertuju."]}],["$","p",null,{"className":"leading-relaxed","children":"Obrnuto važi za određene industrije, na primer hitne usluge (vodoinstalater, ključar, auto servis) imaju visoke mobilne konverzije jer korisnici direktno klikaju na telefon iz oglasa. Razumevanje ponašanja vaše publike je ključno."}],["$","div",null,{"className":"bg-ink-bg p-5 md:p-8 border-l-4 border-wine rounded-r-xl shadow-sm","children":["$","p",null,{"className":"text-ink-text m-0","children":[["$","strong",null,{"className":"text-wine-bright uppercase text-xs md:text-sm tracking-widest block mb-2","children":"Rešenje"}],"U Google Ads, proverite izveštaj \"Devices\" i vidite CPA po uređaju. Podesite bid adjustments za mobilne, tablet i desktop posebno. Za mobilne oglasnike, koristite Call Extensions i Click-to-Call da iskoristite prirodnu prednost mobilnih uređaja."]}]}]]}],["$","div",null,{"className":"space-y-4 md:space-y-6","children":[["$","h2",null,{"className":"font-display font-medium text-2xl md:text-3xl lg:text-4xl text-ink-t